<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GAC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <nav class="shell navline" aria-label="Navegación principal">
        <a class="brand" asp-page="/Articulos/Index"><span class="brand-mark">GAC</span><span>Catálogo científico</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="navitems">
                <a asp-page="/Articulos/Index">Artículos</a>
                <a asp-page="/InformesTecnicos/Index">Informes técnicos</a>
                <a asp-page="/Investigadores/Index">Investigadores</a>
                <a asp-page="/Catalogos/Index">Catálogos</a>
            </div>
            <form method="post" asp-page="/Cuenta/Salir">
                <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
            </form>
        }
    </nav>
</header>
<main class="shell contenido">
    @if (TempData["Aviso"] is string aviso)
    {
        <p role="status" class="alert alert-success">@aviso</p>
    }
    @RenderBody()
</main>
<footer class="shell pie">GAC · Proyecto académico de Programación III · Equipo 1</footer>
<script src="~/js/gac.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
