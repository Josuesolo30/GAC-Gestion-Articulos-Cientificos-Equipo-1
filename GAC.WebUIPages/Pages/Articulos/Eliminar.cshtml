@page "{id:guid}"
@model GAC.WebUIPages.Pages.Articulos.EliminarModel
@{ ViewData["Title"] = "Eliminar artículo"; }
<section class="panel">
    <h1>Eliminar artículo</h1>
    <p>Vas a eliminar <strong>@Model.Articulo.Titulo</strong> y su ubicación, si la tiene.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post" asp-route-id="@Model.Articulo.Id">
        <div class="actions"><button class="btn btn-danger" type="submit">Confirmar eliminación</button>
        <a class="btn btn-outline-secondary" asp-page="./Detalle" asp-route-id="@Model.Articulo.Id">Cancelar</a></div>
    </form>
</section>
